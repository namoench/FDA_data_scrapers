# FDA Data Dashboard API Credentials
# ===================================
# Some scripts require FDA Data Dashboard API credentials.
# Request access at: https://datadashboard.fda.gov/
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control!

FDA_API_USER=your_email@example.com
FDA_API_KEY=your_api_key_here
